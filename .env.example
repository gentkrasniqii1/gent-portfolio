# Public site URL (no trailing slash) — used for canonical URLs, sitemap, OG
NEXT_PUBLIC_SITE_URL=https://your-domain.vercel.app

# Contact form email delivery (Resend)
RESEND_API_KEY=
CONTACT_TO_EMAIL=[YOUR EMAIL]
CONTACT_FROM_EMAIL=Portfolio <onboarding@resend.dev>

# Analytics: @vercel/analytics + @vercel/speed-insights are wired in layout.
# They activate automatically on Vercel — no extra client env vars required.
