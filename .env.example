# Public site URL (no trailing slash) — used for canonical URLs, sitemap, OG
NEXT_PUBLIC_SITE_URL=https://your-domain.vercel.app

# Contact form email delivery (Resend)
RESEND_API_KEY=
# Private inbox that receives messages (never shown on the site)
CONTACT_TO_EMAIL=[YOUR EMAIL]
# Sender on a domain verified in Resend; a bare address gets the
# "Gent Krasniqi Portfolio" display name automatically
CONTACT_FROM_EMAIL=Gent Krasniqi Portfolio <contact@gentkrasniqi.dev>
# Set to true to send visitors a short "I'll reply within 24–48 hours" email
CONTACT_SEND_CONFIRMATION=false

# Analytics: @vercel/analytics + @vercel/speed-insights are wired in layout.
# They activate automatically on Vercel — no extra client env vars required.
